# Lista das variáveis de ambiente que o app usa. Nenhum valor real aqui.
# O app lê variáveis de ambiente, não este arquivo nem um .env. Defina-as no sistema ou deixe o
# serviço carregá-las de um arquivo neste formato (systemd: EnvironmentFile=; Docker: --env-file).
# Esse arquivo com valores nunca entra no git (o .gitignore já ignora .env).

# Banco de produção (PostgreSQL). Ex.: jdbc:postgresql://localhost:5432/financas
DB_URL=
DB_USER=
DB_PASSWORD=

# Chave gratuita da NVD para o OWASP Dependency-Check (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
